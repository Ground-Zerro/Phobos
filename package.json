{
  "private": true,
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up phobos-dev --build",
    "cli:dev": "docker compose -f docker-compose.dev.yml run --build --rm -it phobos-dev cli:dev",
    "build": "docker build -t phobos .",
    "scripts:version": "bash scripts/version.sh",
    "scripts:i18n": "bash scripts/i18n.sh",
    "format:check:docs": "prettier --check docs README.md"
  },
  "devDependencies": {
    "prettier": "^3.8.2"
  },
  "packageManager": "pnpm@10.33.0"
}
